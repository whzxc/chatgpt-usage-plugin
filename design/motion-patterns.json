{
  "version": 1,
  "roles": {
    "duration-base": "--motion-base",
    "duration-loop": "--motion-loop",
    "easing-enter": "--ease-linear",
    "easing-loop": "--ease-linear"
  },
  "patterns": {
    "busy-icon-spin": {
      "kind": "ambient",
      "action": "loop",
      "effect": "spin",
      "properties": ["transform"],
      "parameters": {
        "duration": "--motion-loop",
        "easing": "--ease-linear"
      },
      "interrupt": "cancel",
      "reduced": "static",
      "frames": [{ "source": "design/components/button.tsx", "frame": "actions" }],
      "consumers": [
        { "file": "ui/shared/layout.css", "match": "keyframes:spin" },
        { "file": "ui/shared/layout.css", "match": "css:.is-busy .icon" }
      ]
    },
    "waterfall-visible-range": {
      "kind": "layout",
      "action": "resize",
      "effect": "size",
      "properties": ["x", "width", "--wf-start", "--wf-unit", "--wf-map-start", "--wf-map-width"],
      "parameters": {
        "duration": "--motion-base",
        "easing": "--ease-linear"
      },
      "interrupt": "retarget",
      "reduced": "instant",
      "frames": [
        { "source": "design/modules/waterfall/index.tsx", "frame": "waterfall-completed" },
        { "source": "design/modules/waterfall/index.tsx", "frame": "waterfall-running" }
      ],
      "consumers": [
        { "file": "ui/task/waterfall-clock.ts", "match": "web:requestAnimationFrame", "within": "tick" },
        { "file": "ui/task/waterfall-clock.ts", "match": "web:requestAnimationFrame", "within": "update" }
      ]
    }
  }
}
