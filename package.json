{
  "name": "chatgpt-usage-plugin",
  "version": "0.2.0",
  "description": "Codex usage overview and task insights panels for ChatGPT Desktop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "check": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "build:ui": "node tooling/build-plugin.mjs",
    "build": "node tooling/build.mjs",
    "dev": "node tooling/dev.mjs",
    "plugin:dev": "node tooling/plugin-dev.mjs",
    "plugin:build": "node tooling/package.mjs",
    "plugin:check": "node tooling/check-plugin.mjs",
    "check:format": "prettier --check \"server/**/*.ts\" \"shared/*.ts\" runtime/check-runtime.cjs ui/usage-insights/bridge.ts ui/usage-insights/web.ts ui/plugin-dev.ts \"tooling/*.mjs\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/themes": "^3.3.0",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "prettier": "3.9.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "stream-json": "3.7.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whzxc/chatgpt-usage-plugin.git"
  },
  "homepage": "https://github.com/whzxc/chatgpt-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/whzxc/chatgpt-usage-plugin/issues"
  },
  "keywords": [
    "chatgpt",
    "codex",
    "mcp",
    "usage"
  ],
  "private": true
}
